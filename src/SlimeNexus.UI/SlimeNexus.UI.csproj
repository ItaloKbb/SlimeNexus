<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SlimeNexus.UI</RootNamespace>
    <AssemblyName>SlimeNexus</AssemblyName>
    <ApplicationIcon>Assets\slime.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Ensure Windows GUI subsystem -->
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>

    <!-- Version info for Velopack -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- Application metadata -->
    <Product>SlimeNexus</Product>
    <Company>ItaloKbb</Company>
    <Authors>ItaloKbb</Authors>
    <Description>SlimeNexus - Desktop agent for the AI Tamagotchi. A local brain that manages hardware monitoring, AI inference, and task execution.</Description>
    <Copyright>Copyright � 2024 ItaloKbb</Copyright>
  </PropertyGroup>

  <!-- Publish settings (applied only during dotnet publish) -->
  <PropertyGroup Condition="'$(PublishDir)' != ''">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlimeNexus.Core\SlimeNexus.Core.csproj" />
    <ProjectReference Include="..\SlimeNexus.Infrastructure\SlimeNexus.Infrastructure.csproj" />
    <ProjectReference Include="..\SlimeNexus.Api\SlimeNexus.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform Desktop UI -->
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <!-- Avalonia diagnostics (dev only) -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.1.3" Condition="'$(Configuration)' == 'Debug'" />
    <!-- MVVM Framework -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Markdown.Avalonia" Version="11.0.2" />
    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <!-- Auto-updater -->
    <PackageReference Include="Velopack" Version="0.0.915" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <AvaloniaResource Include="Assets\**" Condition="Exists('Assets')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\slime-icon.svg" />
  </ItemGroup>

</Project>
