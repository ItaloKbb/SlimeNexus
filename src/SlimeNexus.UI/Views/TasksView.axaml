<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SlimeNexus.UI.ViewModels"
             x:Class="SlimeNexus.UI.Views.TasksView"
             x:DataType="vm:TasksViewModel">

    <UserControl.Styles>
        <Style Selector="Button.skill-card">
            <Setter Property="Background" Value="#1a1a2e" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2a2a40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.skill-card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#252540" />
            <Setter Property="BorderBrush" Value="#6c5ce7" />
        </Style>
        <Style Selector="Button.skill-card:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚡ Habilidades OpenClaw" FontSize="22" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Execute tarefas e ganhe XP para seu pet"
                       FontSize="13" Opacity="0.5" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Folder Picker + Stats Bar -->
        <Border Grid.Row="1" Background="#1a1a2e" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                <!-- Folder Picker -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBox Grid.Column="0"
                             Text="{Binding TargetFolder}"
                             Watermark="📁 Caminho da pasta do projeto..."
                             Background="#111122" Foreground="White"
                             CornerRadius="8" Padding="10,8"
                             BorderBrush="#2a2a40" BorderThickness="1"
                             FontSize="12" />
                    <Button Grid.Column="1"
                            Content="Procurar"
                            Command="{Binding BrowseFolderCommand}"
                            Background="#6c5ce7" Foreground="White"
                            CornerRadius="8" Padding="14,8"
                            Margin="8,0,0,0" FontSize="12" />
                </Grid>

                <!-- Stats -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⭐" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalXpEarned, StringFormat='{}{0} XP'}"
                                   FontSize="13" Foreground="#f1c40f" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="✅" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TasksCompleted}"
                                   FontSize="13" Foreground="#2ecc71" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="❌" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TasksFailed}"
                                   FontSize="13" Foreground="#e74c3c" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Execution Status -->
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding ExecutionStatus}"
                           FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Content: Skills + History -->
        <Grid Grid.Row="2" ColumnDefinitions="2*,*" >

            <!-- Skills Grid -->
            <ScrollViewer Grid.Column="0" Margin="0,0,10,0">
                <StackPanel Spacing="8">

                    <!-- Result Banner -->
                    <Border IsVisible="{Binding HasLastResult}"
                            Background="#1a2e1a" CornerRadius="8" Padding="12,10"
                            Margin="0,0,0,4">
                        <TextBlock Text="{Binding LastResultMessage}"
                                   FontSize="12" Foreground="White" TextWrapping="Wrap" />
                    </Border>

                    <!-- Skill Cards -->
                    <ItemsControl ItemsSource="{Binding Skills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SkillCard">
                                <Button Classes="skill-card"
                                        Command="{Binding $parent[ItemsControl].((vm:TasksViewModel)DataContext).ExecuteSkillCommand}"
                                        CommandParameter="{Binding}"
                                        Width="220" Margin="0,0,8,8">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                                <TextBlock Text="{Binding BaseXp, StringFormat='+{0} XP base'}"
                                                           FontSize="10" Foreground="#f1c40f" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- History Panel -->
            <Border Grid.Column="1" Background="#1a1a2e" CornerRadius="12" Padding="14">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="📜 Histórico" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskHistoryEntry">
                                    <Border Background="#111122" CornerRadius="8"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                       FontSize="18" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="White" />
                                                <TextBlock Text="{Binding Message}" FontSize="10"
                                                           Opacity="0.6" TextWrapping="NoWrap"
                                                           MaxWidth="150"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding XpEarned, StringFormat='+{0}'}"
                                                           FontSize="11" Foreground="#f1c40f"
                                                           HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TimeAgo}" FontSize="9"
                                                           Opacity="0.4" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Limpar"
                            Command="{Binding ClearHistoryCommand}"
                            HorizontalAlignment="Stretch"
                            Background="#2a2a40" Foreground="#aaa"
                            CornerRadius="8" Padding="8,6"
                            FontSize="11" Margin="0,8,0,0"
                            HorizontalContentAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
