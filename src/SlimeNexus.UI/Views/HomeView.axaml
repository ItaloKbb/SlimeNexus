<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SlimeNexus.UI.ViewModels"
             x:Class="SlimeNexus.UI.Views.HomeView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="4">

            <!-- Welcome Banner -->
            <Border CornerRadius="16"
                    Padding="28,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#1a1a3e" />
                        <GradientStop Offset="1" Color="#2d1b69" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Olá! 👋" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Bem-vindo ao SlimeNexus, seu assistente AI local."
                                   FontSize="14" Opacity="0.7" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Ellipse Width="10" Height="10">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding IsAiOnline, Converter={StaticResource BoolToGreenRedConverter}}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.8" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="🐾" FontSize="64" Opacity="0.4"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Quick Stats Row -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto">
                <Grid.Styles>
                    <Style Selector="Border.stat-card">
                        <Setter Property="Background" Value="#1E1E2E" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="Padding" Value="20,16" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                </Grid.Styles>

                <!-- AI Status Card -->
                <Border Grid.Column="0" Classes="stat-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🤖" FontSize="24" />
                        <TextBlock Text="AI Status" FontSize="12" Opacity="0.5" />
                        <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Pet Card -->
                <Border Grid.Column="1" Classes="stat-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🐾" FontSize="24" />
                        <TextBlock Text="Pet" FontSize="12" Opacity="0.5" />
                        <TextBlock Text="Slimey" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Tasks Card -->
                <Border Grid.Column="2" Classes="stat-card" Margin="0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="📋" FontSize="24" />
                        <TextBlock Text="Tasks Hoje" FontSize="12" Opacity="0.5" />
                        <TextBlock Text="0 concluídas" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Actions -->
            <Border Background="#1E1E2E" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Ações Rápidas" FontSize="16" FontWeight="SemiBold" />
                    <WrapPanel Orientation="Horizontal">
                        <WrapPanel.Styles>
                            <Style Selector="Button.action-btn">
                                <Setter Property="Background" Value="#2a2a4e" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Padding" Value="16,12" />
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style Selector="Button.action-btn:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#3a3a6e" />
                            </Style>
                        </WrapPanel.Styles>

                        <Button Classes="action-btn" Command="{Binding GoToChatCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="💬" FontSize="16" />
                                <TextBlock Text="Abrir Chat" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="action-btn" Command="{Binding GoToHardwareCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="💻" FontSize="16" />
                                <TextBlock Text="Ver Hardware" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="action-btn" Command="{Binding GoToPetCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🐾" FontSize="16" />
                                <TextBlock Text="Meu Pet" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Recent Activity (placeholder) -->
            <Border Background="#1E1E2E" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Atividade Recente" FontSize="16" FontWeight="SemiBold" />
                    <Border Background="#151525" CornerRadius="8" Padding="16">
                        <TextBlock Text="Nenhuma atividade recente. Comece uma conversa no Chat! 💬"
                                   FontSize="13" Opacity="0.5" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
