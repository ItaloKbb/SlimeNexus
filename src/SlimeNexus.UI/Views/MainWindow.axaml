<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SlimeNexus.UI.ViewModels"
        xmlns:views="using:SlimeNexus.UI.Views"
        x:Class="SlimeNexus.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SlimeNexus Dashboard"
        Width="900" Height="700"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#121212">
    
    <Grid RowDefinitions="Auto,*">
        
        <!-- Navigation Header -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Logo & Title -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="🐾" FontSize="28" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SlimeNexus" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="AI Pet Assistant" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
                
                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <RadioButton Content="🏠 Home" 
                                 GroupName="Nav"
                                 IsChecked="{Binding IsHomeSelected}"
                                 Classes="nav-tab" />
                    <RadioButton Content="💻 Hardware" 
                                 GroupName="Nav"
                                 IsChecked="{Binding IsHardwareSelected}"
                                 Classes="nav-tab" />
                    <RadioButton Content="🐾 Pet" 
                                 GroupName="Nav"
                                 IsChecked="{Binding IsPetSelected}"
                                 Classes="nav-tab" />
                    <RadioButton Content="📋 Tasks" 
                                                        GroupName="Nav"
                                                          IsChecked="{Binding IsTasksSelected}"
                                                          Classes="nav-tab" />
                                         </StackPanel>

                                         <!-- Status Indicator -->
                                         <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                             <Ellipse Width="10" Height="10">
                                                 <Ellipse.Fill>
                                                     <SolidColorBrush Color="{Binding IsAiOnline, Converter={StaticResource BoolToGreenRedConverter}}" />
                                                 </Ellipse.Fill>
                                             </Ellipse>
                                             <TextBlock Text="{Binding StatusText}" 
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Opacity="0.8" />
                                         </StackPanel>
                                     </Grid>
                                 </Border>
        
        <!-- Content Area -->
        <Border Grid.Row="1" Padding="16">
            <ContentControl Content="{Binding CurrentView}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <views:HardwareDashboardView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
        
    </Grid>
    
    <Window.Styles>
        <Style Selector="RadioButton.nav-tab">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="RadioButton.nav-tab:checked">
            <Setter Property="Background" Value="#333333" />
        </Style>
    </Window.Styles>
    
</Window>
