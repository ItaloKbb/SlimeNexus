<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SlimeNexus.UI.ViewModels"
        xmlns:views="using:SlimeNexus.UI.Views"
        x:Class="SlimeNexus.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SlimeNexus Dashboard"
        Icon="avares://SlimeNexus/Assets/slime.ico"
        Width="960" Height="700"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0d0d1a">

    <Window.Styles>
        <!-- Sidebar nav button base -->
        <Style Selector="RadioButton.sidebar-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#888" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="RadioButton.sidebar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1a1a2e" />
            <Setter Property="Foreground" Value="#ccc" />
        </Style>
        <Style Selector="RadioButton.sidebar-btn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#6c5ce7" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#111122" Padding="12">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="8,8,8,20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🐾" FontSize="28" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SlimeNexus" FontSize="18" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="AI Pet Assistant" FontSize="10" Opacity="0.5" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock Text="MENU" FontSize="10" Opacity="0.3"
                               Margin="8,0,0,6" FontWeight="SemiBold" />

                    <RadioButton GroupName="Nav"
                                 IsChecked="{Binding IsHomeSelected}"
                                 Classes="sidebar-btn">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🏠" FontSize="16" />
                            <TextBlock Text="Home" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Nav"
                                 IsChecked="{Binding IsChatSelected}"
                                 Classes="sidebar-btn">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="💬" FontSize="16" />
                            <TextBlock Text="Chat AI" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Nav"
                                 IsChecked="{Binding IsHardwareSelected}"
                                 Classes="sidebar-btn">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="💻" FontSize="16" />
                            <TextBlock Text="Hardware" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Nav"
                                 IsChecked="{Binding IsPetSelected}"
                                 Classes="sidebar-btn">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🐾" FontSize="16" />
                            <TextBlock Text="Meu Pet" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Nav"
                                 IsChecked="{Binding IsTasksSelected}"
                                 Classes="sidebar-btn">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📋" FontSize="16" />
                            <TextBlock Text="Tasks" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Footer Status -->
                <Border Grid.Row="2" Background="#1a1a2e" CornerRadius="10" Padding="12,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding IsAiOnline, Converter={StaticResource BoolToGreenRedConverter}}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11" Opacity="0.7"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1" Padding="20,16">
            <Panel>

                <!-- Home Tab -->
                <Panel IsVisible="{Binding IsHomeSelected}">
                    <views:HomeView />
                </Panel>

                <!-- Chat Tab -->
                <Panel IsVisible="{Binding IsChatSelected}">
                    <views:ChatView />
                </Panel>

                <!-- Hardware Tab -->
                <Panel IsVisible="{Binding IsHardwareSelected}">
                    <views:HardwareDashboardView />
                </Panel>

                <!-- Pet Tab -->
                <Panel IsVisible="{Binding IsPetSelected}">
                    <views:PetTabView />
                </Panel>

                <!-- Tasks Tab -->
                <Panel IsVisible="{Binding IsTasksSelected}">
                    <views:TasksView />
                </Panel>

            </Panel>
        </Border>

    </Grid>
</Window>
