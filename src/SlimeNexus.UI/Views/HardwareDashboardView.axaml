<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SlimeNexus.UI.ViewModels"
             x:Class="SlimeNexus.UI.Views.HardwareDashboardView"
             x:DataType="vm:HardwareDashboardViewModel">
    
    <Design.DataContext>
        <vm:HardwareDashboardViewModel />
    </Design.DataContext>
    
    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🖥️ Hardware Dashboard" 
                       FontSize="24" 
                       FontWeight="Bold" />
            <TextBlock Text="{Binding StatusMessage}" 
                       FontSize="12" 
                       Opacity="0.7" />
        </StackPanel>
        
        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                
                <!-- GPU Section -->
                <Border Background="#1E1E1E" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🎮" FontSize="20" />
                            <TextBlock Text="Graphics Card" FontSize="18" FontWeight="SemiBold" />
                            <Border Background="#4CAF50"
                                    CornerRadius="4" 
                                    Padding="8,2"
                                    IsVisible="{Binding SupportsCuda}">
                                <TextBlock Text="CUDA" FontSize="10" Foreground="White" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding GpuName}" FontSize="14" Opacity="0.9" />
                        
                        <!-- VRAM Bar -->
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="VRAM Usage" FontSize="12" />
                                <TextBlock FontSize="12" Opacity="0.7">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F0}% ({1} / {2} MB)">
                                            <Binding Path="VramUsagePercent" />
                                            <Binding Path="VramAvailableMb" />
                                            <Binding Path="VramTotalMb" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            
                            <ProgressBar Grid.Row="1" 
                                         Value="{Binding VramUsagePercent}" 
                                         Maximum="100" 
                                         Height="8"
                                         Margin="0,8,0,0"
                                         CornerRadius="4" />
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- CPU Section -->
                <Border Background="#1E1E1E" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="⚡" FontSize="20" />
                            <TextBlock Text="Processor" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        
                        <TextBlock Text="{Binding CpuName}" FontSize="14" Opacity="0.9" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <StackPanel>
                                <TextBlock Text="Cores" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{Binding CpuCores}" FontSize="18" FontWeight="Bold" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- RAM Section -->
                <Border Background="#1E1E1E" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="💾" FontSize="20" />
                            <TextBlock Text="Memory" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        
                        <!-- RAM Bar -->
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="RAM Usage" FontSize="12" />
                                <TextBlock FontSize="12" Opacity="0.7">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F0}% ({1} / {2} MB)">
                                            <Binding Path="RamUsagePercent" />
                                            <Binding Path="RamAvailableMb" />
                                            <Binding Path="RamTotalMb" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            
                            <ProgressBar Grid.Row="1" 
                                         Value="{Binding RamUsagePercent}" 
                                         Maximum="100" 
                                         Height="8"
                                         Margin="0,8,0,0"
                                         CornerRadius="4" />
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- AI Inference Section -->
                <Border Background="#1E1E1E" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🤖" FontSize="20" />
                            <TextBlock Text="AI Inference" FontSize="18" FontWeight="SemiBold" />
                            <Border CornerRadius="4" 
                                    Padding="8,2"
                                    IsVisible="{Binding IsAiAvailable}"
                                    Background="#4CAF50">
                                <TextBlock Text="Online"
                                           FontSize="10" 
                                           Foreground="White" />
                            </Border>
                            <Border CornerRadius="4" 
                                    Padding="8,2"
                                    IsVisible="{Binding !IsAiAvailable}"
                                    Background="#EF5350">
                                <TextBlock Text="Offline"
                                           FontSize="10" 
                                           Foreground="White" />
                            </Border>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Can Run Local AI" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{Binding CanRunLocalInference}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="Suggested Quantization" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{Binding SuggestedQuantization}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Recommended Model" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{Binding RecommendedModel}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SlimeAccentBrush}" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="AI Provider" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{Binding AiProviderName}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <CheckBox Content="Auto-refresh (30s)" 
                          IsChecked="{Binding AutoRefresh}" />
                <TextBlock Text="{Binding LastUpdated, StringFormat='Last updated: {0:HH:mm:ss}'}" 
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.7" />
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Content="🔄 Refresh" 
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsBusy}" />
        </Grid>
        
        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" 
                Background="#80000000" 
                IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" />
                <TextBlock Text="{Binding BusyMessage}" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>
        
    </Grid>
</UserControl>
