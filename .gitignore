[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.user
*.suo
*.userosscache
*.sln.docstates

# ─── .NET Runtime & Packages ─────────────────────────────────
.nuget/
packages/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# ─── Visual Studio ───────────────────────────────────────────
.vs/
*.vsp
*.vspx
*.sap
*.vssettings
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/
*.ncb
*.opensdf
*.sdf
*.cachefile
